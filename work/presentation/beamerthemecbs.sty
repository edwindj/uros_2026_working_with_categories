% ==== Kleuren schema ====
\colorlet{cbs1}{corporatelichtblauw}
\colorlet{cbs2}{corporateblauw}

\colorlet{cbsbasis}{cbs1}
\colorlet{cbstekst}{cbs2}
\colorlet{cbsachtergrond}{white}

\newcommand{\invert}{
  \colorlet{cbsbasis}{white}
  \colorlet{cbstekst}{white}
  \colorlet{cbsachtergrond}{cbs1}
  \usebeamercolor[fg]{normal text}
}
\newcommand{\revert}{
  \colorlet{cbsbasis}{cbs1}
  \colorlet{cbstekst}{cbs2}
  \colorlet{cbsachtergrond}{white}
  \usebeamercolor[fg]{normal text}
}


% ==== Stel de fonts in ==== 

% Maak het document op in Corbel met Cambria voor headings; Cambria is te 
% benaderen met \serif
\RequirePackage{fontspec}

\setmainfont[
    Path = "./templatefiles/", 
    Extension=.otf,
    UprightFont=*-Regular,
    BoldFont=*-Bold,
    ItalicFont=*-Italic
  ]{SohoPro}
% De sansfont is uiteindelijk het hoofdfont voor de slides
\setsansfont[
    Path = "./templatefiles/", 
    Extension=.otf,
    UprightFont=*-Light,
    BoldFont=*-Medium,
    ItalicFont=*-LightItalic
  ]{AkkoPro}
\setmonofont[
    Path = "./templatefiles/", 
    Extension=.ttf,
    UprightFont=consola,
    BoldFont=*b,
    ItalicFont=*i,
    BoldItalicFont=*z,
    Scale=MatchLowercase
  ]{consola}
%% Math
% Issue with quarto: \RequirePackage[bold-style=ISO]{unicode-math}
\RequirePackage{unicode-math}
\setmathfont[Path = "./templatefiles/"]{cambria.ttc}

\linespread{1.2}
\setlength{\parskip}{\baselineskip}

% ==== Lijsten ====
\setbeamercolor{enumerate item}{fg=cbstekst}
\setbeamercolor{enumerate subitem}{fg=cbstekst}
\setbeamercolor{enumerate subsubitem}{fg=cbstekst}
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{enumerate subitem}{\insertsubenumlabel}
\setbeamertemplate{enumerate subsubitem}{\insertsubsubenumlabel}

\setbeamercolor{itemize item}{fg=cbstekst}
\setbeamercolor{itemize subitem}{fg=cbstekst}
\setbeamercolor{itemize subsubitem}{fg=cbstekst}
\setbeamertemplate{itemize item}{—}
\setbeamertemplate{itemize subitem}{—}
\setbeamertemplate{itemize subsubitem}{—}

